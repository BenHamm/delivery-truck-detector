[Unit]
Description=Run Orin Stage 1 canary once per hour (cold inference)

[Timer]
# Fire 5min after boot, then once per hour. Each canary run forces a
# cache miss (varying prompt nonce) so the full inference path is
# exercised -- ~22s of llama-server time. Hourly cadence makes
# collision with production polls a <1%/hour event.
OnBootSec=5min
OnUnitActiveSec=1h
# Don't pile up missed runs after a long sleep
Persistent=false

[Install]
WantedBy=timers.target
