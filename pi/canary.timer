[Unit]
Description=Run Orin Stage 1 canary every 10 minutes during active hours

[Timer]
# Fire 30s after boot, then every 10min. Detector active hours are 8a-8p,
# but the canary keeps testing the endpoint outside those hours too --
# catches a model that died overnight before the next active window.
OnBootSec=30s
OnUnitActiveSec=10min
# Don't pile up missed runs after a long sleep
Persistent=false

[Install]
WantedBy=timers.target
