# Snapshot Forwarder — Pi environment variables
# Copy to ~/.env and fill in values

# Camera — set ONE of these:
# HTTP snapshot (if your camera supports it):
# CAMERA_SNAPSHOT_URL=http://192.168.1.XXX/snapshot.jpg

# RTSP (Tapo cameras use this):
CAMERA_RTSP_URL=rtsp://USER:PASS@CAMERA_IP:554/stream1

# Jetson endpoint (Ben's Orin over Tailscale)
JETSON_URL=http://100.118.29.32:5555/upload

# How often to grab a frame (seconds)
INTERVAL_SECONDS=3
