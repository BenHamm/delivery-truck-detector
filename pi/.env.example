# Delivery Truck Detector — Pi environment variables
# Used by detector.service

# Camera (Tapo C320WS)
CAMERA_IP=10.0.0.88
CAMERA_USER=gregtapo
CAMERA_PASS=changeme

# Roboflow (free tier — stage 1)
ROBOFLOW_API_KEY=your_roboflow_api_key
ROBOFLOW_MODEL=coco/3
ROBOFLOW_CONFIDENCE=20

# OpenRouter / Gemini Flash (stage 2 — only on detections)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=google/gemini-3-flash-preview

# Pushover (notifications)
PUSHOVER_USER_KEY=your_pushover_user_key
PUSHOVER_APP_TOKEN=your_pushover_app_token

# Timing
INTERVAL_SECONDS=30
COOLDOWN_SECONDS=600
START_HOUR=8
END_HOUR=20
