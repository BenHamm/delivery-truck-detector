# Delivery Truck Detector — Pi environment variables
# Used by detector.service

# Camera (Tapo C320WS)
CAMERA_IP=10.0.0.88
CAMERA_USER=gregtapo
CAMERA_PASS=changeme

# OpenRouter / Gemini Flash (Stage 2 carrier classifier; also Stage 1
# fallback when ORIN_BASE_URL is unset or an Orin call fails)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=google/gemini-3-flash-preview

# Optional: Orin local Stage 1 (Qwen3-VL-8B via llama-server).
# When set, Stage 1 polls hit Orin first with a permissive prompt and
# fall back to Gemini on any failure. When unset, behavior is identical
# to the all-Gemini pipeline.
# ORIN_BASE_URL=http://100.118.29.32:8080/v1
# ORIN_MODEL=qwen3-vl

# Pushover — two recipient tiers
# PUSHOVER_USER_KEY: "premium" tier — only gets UPS/FedEx alerts. Single user
#   key, or a Delivery Group key for users who don't want Amazon spam.
# PUSHOVER_KEY_ALL: "all-carriers" tier — gets UPS, FedEx, AND Amazon.
#   Typically a Delivery Group key. Leave empty to disable this tier entirely.
# UPS/FedEx events fan out to BOTH keys; Amazon goes to PUSHOVER_KEY_ALL only.
# USPS is excluded entirely — postal carriers have building access, no alert needed.
PUSHOVER_USER_KEY=your_pushover_user_or_premium_group_key
PUSHOVER_KEY_ALL=
PUSHOVER_APP_TOKEN=your_pushover_app_token

# Timing
INTERVAL_SECONDS=30
COOLDOWN_SECONDS=600
START_HOUR=8
END_HOUR=20

# Image log retention + NO-frame sampling cadence
LOG_RETENTION_HOURS=36
NO_SAMPLE_INTERVAL=25  # ~25s threshold: save every poll, so we always have a NO frame ~30s before a tentative YES for lead-up audit

# Healthchecks.io dead-man's switch (rotate this if you fork the project)
HC_PING_URL=https://hc-ping.com/your-uuid-here
