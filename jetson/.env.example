# Delivery Truck Detector — Jetson environment variables
# Copy to .env and fill in values

# YOLO
YOLO_MODEL_PATH=yolov8n.engine
CONFIDENCE_THRESHOLD=0.45

# Pushover (push notifications)
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# Notification cooldown (seconds)
COOLDOWN_SECONDS=600

# Server port
PORT=5555

# Local RTSP camera (optional, for testing)
# RTSP_URL=rtsp://user:pass@10.0.0.88:554/stream1
# RTSP_INTERVAL=3
