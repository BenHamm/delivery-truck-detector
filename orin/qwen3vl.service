[Unit]
Description=Qwen3-VL-8B llama-server (Stage 1 binary classifier)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orin
Group=orin
WorkingDirectory=/home/orin/qwen3-vl

# llama-server runs the OpenAI-compatible HTTP endpoint.
# --host 0.0.0.0 binds to all interfaces -- Tailscale ACL is the
#   network-level guard; the Pi reaches us via Tailscale subnet route.
#   If you need to lock this down further, restrict at the firewall layer.
# --port 8080 is well-clear of HA (8123), mosquitto (1883), and OpenClaw
#   (18789-18790).
# -ngl 99 offloads all layers to GPU.
# -c 8192 context window (image + prompt fits comfortably).
# -ctk q8_0 -ctv q8_0 quantize KV cache to save memory; recommended by
#   the WayBob Jetson recipe.
# --no-mmap avoids loading the whole model into pagecache (zram swap can
#   fight with mmap on Jetson).
# --cache-ram 256 caps the prompt cache at 256 MiB. The default of 8 GiB
#   blew us up on May 2 by accumulating ~78 MiB per unique production
#   poll until it hit the cgroup MemoryMax. We then disabled it entirely
#   (--cache-ram 0), which fixed the crash but caused a new problem:
#   the canary's repeat images (yes.jpg / no.jpg) no longer hit cache,
#   so each canary run took ~22s of llama-server time and collided with
#   production polls every 10 min, generating ~17 fallbacks per active
#   day. 256 MiB holds ~3 cached prompts -- enough to keep the canary's
#   2 images warm, while LRU evicts production frames immediately
#   (each is unique, so they never benefit from caching). Best of both:
#   canary fast, no risk of cache-driven OOM.
ExecStart=/home/orin/llama.cpp/build/bin/llama-server \
    --model /home/orin/qwen3-vl/Qwen3VL-8B-Instruct-Q4_K_M.gguf \
    --mmproj /home/orin/qwen3-vl/mmproj-Qwen3VL-8B-Instruct-Q8_0.gguf \
    --host 0.0.0.0 \
    --port 8080 \
    -ngl 99 \
    -c 8192 \
    -ctk q8_0 \
    -ctv q8_0 \
    --cache-ram 256 \
    --no-mmap

# Resource hardening: if the model OOMs, llama-server gets killed, NOT
# Home Assistant or any other service.
#
# Sized 12G after the May 13 audit: steady-state working set on Jetson
# unified memory is ~7.8 GB (model 5.3 + mmproj 0.7 + KV 0.6 +
# cache 0.25 + CUDA workspace/activations ~1.0). The earlier 8G value
# was based on a wrong mental model that didn't account for CUDA-side
# allocations showing up in cgroup memory accounting on Jetson (where
# unified memory means GPU buffers are charged against the cgroup).
#
# Note that the May 2 OOM lesson (cap prompt cache via --cache-ram) is
# preserved separately and unchanged -- this cap protects against the
# cache-growth failure mode regardless of MemoryMax.
MemoryMax=12G
CPUWeight=50
IOWeight=50
Nice=10

# Environment
Environment="PATH=/home/orin/.local/bin:/usr/local/cuda/bin:/usr/bin:/bin"
Environment="LD_LIBRARY_PATH=/usr/local/cuda/lib64"

# Restart policy: stay up under transient failures.
Restart=on-failure
RestartSec=10s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qwen3vl

[Install]
WantedBy=multi-user.target
